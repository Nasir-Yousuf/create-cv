# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cv_builder?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Dedicated Administrator Account (hashed via bcrypt on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Payment Configuration (Manual bKash)
BKASH_NUMBER=01XXXXXXXXX
CV_EXPORT_PRICE_BDT=10

# Google Gemini AI (Optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_PROJECT_ID=your_gemini_project_id

# Cloudinary / Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
